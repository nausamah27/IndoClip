# IndoClip Pro Backend Configuration
# Masukkan GEMINI_API_KEY Anda di sini atau lewat UI Control Panel
GEMINI_API_KEY=
PORT=8000
HOST=127.0.0.1
TEMP_DIR=./temp
OUTPUT_DIR=./outputs
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Optimasi CPU Khusus Intel Core i7-8665U (4 Cores / 8 Threads, Tanpa GPU NVIDIA)
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_CPU_THREADS=6
WHISPER_BEAM_SIZE=1
FFMPEG_THREADS=4
FFMPEG_PRESET=veryfast
